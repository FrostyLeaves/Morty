include "Utility/MRenderGlobal.fbs";

namespace morty.fbs;

table MSlice
{
    offset: uint;
    num: uint;
}

table MClusterBounds
{
    position: Vector3;
    radius: float;
    error: float;
}

table MCluster
{
    vertex: [byte];
    index: [uint];

    group: int;
    refined: int;
    bounds: MClusterBounds;
}

table MClusterGroup
{
    cluster_offset: uint;
    cluster_num: uint;
    bounds: MClusterBounds;
}

file_identifier "MFBS";