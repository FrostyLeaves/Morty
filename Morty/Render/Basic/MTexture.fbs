include "Math/Vector.fbs";
include "Utility/MRenderGlobal.fbs";
namespace morty.fbs;

table MTextureDesc
{
    name: string;
    size: Vector3i;
    layer: uint32;
    texture_type: METextureType;
    format: METextureFormat;
    mipmap_type: MEMipmapDataType;
    read_usage: uint32;
    write_usage: uint32;
}

file_identifier "MFBS";