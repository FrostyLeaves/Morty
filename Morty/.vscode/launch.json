{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Launch Editor",
            "type": "lldb",
            "request": "launch",
            "program": "${command:cmake.launchTargetPath}",
            "args": ["editor"],
            "cwd": "${workspaceFolder}",
            "preLaunchTask": "CMake: build"
        },
        {
            "name": "Launch Editor with Scene",
            "type": "lldb", 
            "request": "launch",
            "program": "${command:cmake.launchTargetPath}",
            "args": ["editor", "--scene", "assets/scenes/default.scene"],
            "cwd": "${workspaceFolder}",
            "preLaunchTask": "CMake: build"
        },
        {
            "name": "Import Model",
            "type": "lldb",
            "request": "launch", 
            "program": "${command:cmake.launchTargetPath}",
            "args": ["import", "model", "${workspaceFolder}/../Resource/Model/banana/ripe-banana.obj", "${workspaceFolder}/../Build/Resource/banana"],
            "cwd": "${workspaceFolder}",
            "preLaunchTask": "CMake: build"
        },
        {
            "name": "Generate Reflection",
            "type": "debugpy",
            "request": "launch",
            "program": "${workspaceFolder}/../Script/reflector/generate_reflector.py",
            "args": ["${workspaceFolder}", "${command:cmake.buildDirectory}"]
        }
    ]
}