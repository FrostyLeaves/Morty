include "TaskGraph/MTaskNode.fbs";
namespace morty.fbs;

table MTaskNodeInputDesc
{
    link_node_id: uint;
    link_output_id: uint;
}

table MTaskNodeOutputDesc
{
}

table MTaskNodeDesc
{
    node_id: uint;
	node_type: string;

    inputs: [MTaskNodeInputDesc];
    outputs: [MTaskNodeOutputDesc];

	data: [ubyte];
}


table MTaskGraph
{
    node_array: [MTaskNodeDesc];
}

root_type MTaskGraph;

file_identifier "MFBS";